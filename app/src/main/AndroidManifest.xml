<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Special app access the user enables in Settings > Usage access.
         It is the only permission Offline Checker declares. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <!-- Not a permission: restores visibility of launchable apps on Android 11+.
         Without this, PackageManager hides third-party apps by default. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Deliberately not declared: android.permission.QUERY_ALL_PACKAGES.
         Adding it lists non-launchable background/system apps too, but Google Play
         restricts it. Offline Checker keeps the manifest minimal; see README. -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
